# Working data: datasets, trained models, run results, figures. Regenerate with
# the scripts; none of it is source.
outputs/

# Reports are what *you* generate about *your* motor. The folder is committed so
# the app has somewhere to write on a fresh clone; its contents never are.
reports/*
!reports/.gitkeep

# The motor is yours. The repository is the tool, not anybody's design, so the
# folder ships empty and whatever you drop in stays on your machine.
motor/*
!motor/.gitkeep

# openMotor is GPLv3 and is cloned by scripts/setup_env.sh, not redistributed here.
vendor/

# Plotly's bundled JS is copied out of the pip package at setup time (4 MB).
app/static/vendor/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
